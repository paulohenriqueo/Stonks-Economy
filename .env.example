# Configuração do Firebase (app web). Copie para .env.local e preencha.
# Onde achar: Firebase Console → Configurações do projeto → Seus apps → Configuração do SDK.
# Esses valores identificam o projeto e não são secretos. Quem protege os dados são
# as regras do Firestore (firestore.rules). Mesmo assim, o .env.local não vai para o git.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: usar o Firebase Emulator em vez do projeto real.
# (O docker compose já define essas variáveis por conta própria.)
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
